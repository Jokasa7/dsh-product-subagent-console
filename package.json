{
  "name": "dsh-product-subagent-console",
  "version": "0.4.0-alpha.1",
  "description": "Plan, run, and compare multi-Agent work inside DeepSeek Harness conversations",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/types/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./planner": {
      "types": "./lib/types/planner.d.ts",
      "default": "./lib/planner.js"
    },
    "./plan-tool": {
      "types": "./lib/types/plan-tool.d.ts",
      "default": "./lib/plan-tool.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tool.js",
    "lib/invariant.js",
    "lib/planner.js",
    "lib/plan-tool.js",
    "lib/types.js",
    "lib/*.mjs",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/getting-started.md",
    "docs/getting-started.zh.md",
    "docs/agent-planner.md",
    "docs/agent-planner.zh.md",
    "docs/troubleshooting.md",
    "docs/troubleshooting.zh.md",
    "docs/assets/subagent-canvas-live.jpg",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "build:artifacts": "pnpm run clean && tsc -p tsconfig.build.json && tsdown && pnpm run verify:dist",
    "build": "pnpm run typecheck && pnpm run test && pnpm run build:artifacts",
    "prepare": "pnpm run build:artifacts",
    "prepack": "pnpm run build",
    "pack:check": "pnpm run build:artifacts && pnpm run verify:pack",
    "publint": "publint"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jokasa7/dsh-product-subagent-console.git"
  },
  "bugs": {
    "url": "https://github.com/Jokasa7/dsh-product-subagent-console/issues"
  },
  "homepage": "https://github.com/Jokasa7/dsh-product-subagent-console#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "codex",
    "claude-code",
    "multi-agent",
    "agent-planner",
    "workflow"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-workflow-worker-thread": "0.1.1-rc.2",
    "@xyflow/react": "12.11.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "publint": "^0.3.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
